# Copy this file to .env and fill in the values.
# .env is gitignored — never commit the real token.

# typically 192.168.x.y
API_LAN_IP=

API_PATH_HOST_MACHINE=

API_PORT=8000

# From: Cloudflare Zero Trust dashboard → Networks → Tunnels → <tunnel> → Configure → Install connector
CLOUDFLARE_TUNNEL_TOKEN=
